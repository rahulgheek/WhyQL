# Copy to .env for local runs. Never commit .env (it is git-ignored).
# PowerShell: Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; if ($k) { Set-Item "env:$k" $v } }

# Groq (OpenAI-compatible) key. Required from Phase 4 on; Phase 1 boots with a dummy value.
GROQ_API_KEY=your-groq-api-key-here

# App database (compose.yaml defaults match these; set only to override).
DB_NAME=whyql
DB_USER=whyql
DB_PASSWORD=whyql

# Auth (email OTP + JWT are wired; OAuth needs real provider credentials to log in).
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=change-me-min-32-chars
ENCRYPTION_KEY=change-me-32-byte-base64

# Google OAuth: https://console.cloud.google.com/apis/credentials (web client).
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Datasource safety: cloud mode blocks internal/metadata hosts in user-supplied
# JDBC URLs. For local dev against a localhost database EITHER run with
# WHYQL_CLOUD_MODE=false OR allowlist the host (comma-separated, no spaces).
# PowerShell: $env:WHYQL_CLOUD_MODE="false"
WHYQL_CLOUD_MODE=true
WHYQL_ALLOWLIST=

# GitHub OAuth: https://github.com/settings/developers (OAuth App, read-only scopes).
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Dev SMTP sink (MailHog: SMTP 1025, UI http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
