# Canonical GraphQL contract for WhyQL.
# Mirrors frontend/lib/graphql.ts (dataSources / addDataSource / askQuestion / job)
# plus the jobUpdates subscription. Resolvers live in the api module.
# "Json" carries heterogeneous SQL result cells (numbers, strings, nulls,
# timestamps) without committing to a scalar type for every column.

scalar Json

enum Engine {
  POSTGRES
  MYSQL
}

enum JobStatus {
  QUEUED
  GENERATING
  VALIDATING
  EXECUTING
  ANALYZING
  COMPLETED
  NEEDS_CLARIFICATION
  FAILED
}

enum WidgetMode {
  MANUAL
  SQL
  QUESTION
}

enum ChartKind {
  TABLE
  BAR
  LINE
  PIE
}

type Board {
  id: ID!
  title: String!
  widgets: [BoardWidget!]!
  createdAt: String!
}

type BoardWidget {
  id: ID!
  boardId: ID!
  title: String!
  dataSourceId: ID!
  mode: WidgetMode!
  tableName: String
  sqlText: String
  question: String
  chartKind: ChartKind!
  ordinal: Int!
  status: String!
  errorMessage: String
  result: QueryResult
  createdAt: String
  updatedAt: String
}

input BoardWidgetInput {
  id: ID
  title: String!
  dataSourceId: ID!
  mode: WidgetMode!
  tableName: String
  sqlText: String
  question: String
  chartKind: ChartKind!
  ordinal: Int!
}

type DataSource {
  id: ID!
  name: String!
  engine: Engine!
  sandbox: Boolean!
  createdAt: String!
}

input AddDataSourceInput {
  name: String!
  engine: Engine!
  jdbcUrl: String!
  username: String
  password: String
}

type AddDataSourcePayload {
  dataSource: DataSource!
  warnings: [String!]!
}

input AskQuestionInput {
  dataSourceId: ID!
  question: String!
  chatSessionId: ID
}

type AskQuestionPayload {
  jobId: ID!
  status: JobStatus!
}

type ResultColumn {
  name: String!
  typeName: String!
}

type QueryResult {
  columns: [ResultColumn!]!
  rows: [Json!]
  truncated: Boolean!
}

type Job {
  id: ID!
  status: JobStatus!
  progress: Int!
  ownerUserId: String!
  dataSourceId: ID!
  question: String!
  errorMessage: String
  result: QueryResult
  resultSections: [ResultSection!]!
  analysis: String
  clarifyingQuestions: [String!]
  createdAt: String
  updatedAt: String
}

"""One answer part. OK sections carry rows; TOO_LARGE ones carry the count instead."""
type ResultSection {
  title: String
  sizeCategory: String!
  totalRows: Int
  result: QueryResult
}

type DashboardCard {
  id: ID!
  jobId: ID!
  dataSourceId: ID
  question: String!
  engine: String
  result: QueryResult
  createdAt: String
}

"""A saved conversation; messageCount badges how much is inside."""
type ChatSession {
  id: ID!
  title: String
  dataSourceId: ID
  messageCount: Int!
  createdAt: String!
  updatedAt: String!
}

"""One chat bubble. text may be null — the linked job renders richly."""
type ChatMessage {
  id: ID!
  role: String!
  text: String
  jobId: ID
  createdAt: String!
}

type ChatSessionPage {
  items: [ChatSession!]!
  total: Int!
  page: Int!
  size: Int!
  hasNext: Boolean!
}

type ChatMessagePage {
  items: [ChatMessage!]!
  total: Int!
  page: Int!
  size: Int!
  hasNext: Boolean!
}

type Query {
  health: String!
  dataSources: [DataSource!]!
  job(id: ID!): Job!
  dashboard: [DashboardCard!]!
  boards: [Board!]!
  board(id: ID!): Board!
  schemaTables(dataSourceId: ID!): [String!]!
  chatSessions(page: Int, size: Int): ChatSessionPage!
  chatMessages(sessionId: ID!, page: Int, size: Int): ChatMessagePage!
}

type Mutation {
  addDataSource(input: AddDataSourceInput!): AddDataSourcePayload!
  askQuestion(input: AskQuestionInput!): AskQuestionPayload!
  saveToDashboard(jobId: ID!): DashboardCard!
  removeDashboardCard(id: ID!): Boolean!
  createBoard(title: String!): Board!
  removeBoard(id: ID!): Boolean!
  saveBoardWidget(boardId: ID!, input: BoardWidgetInput!): BoardWidget!
  removeBoardWidget(boardId: ID!, widgetId: ID!): Boolean!
  createChatSession(title: String, dataSourceId: ID): ChatSession!
  renameChatSession(id: ID!, title: String!): ChatSession!
  deleteChatSession(id: ID!): Boolean!
}

type Subscription {
  jobUpdates(jobId: ID!): Job!
}
